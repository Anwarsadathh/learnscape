# Environment Variables
.env
.env.local
.env.production
.env.development

# Node modules
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database
*.db
*.sqlite

# ===== UPLOAD FILES - EXCLUDE FROM GIT =====
# Ignore all files in uploads but keep directories
uploads/**/*

# Keep .gitkeep files to maintain directory structure
!uploads/.gitkeep
!uploads/*/.gitkeep

# ===== COMMON FILES TO IGNORE =====
# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Build outputs
dist/
build/
coverage/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock
